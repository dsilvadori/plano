APP_NAME="Plano Vencendo Concursos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

AUTH_PASSWORD_RESET_EXPIRE=2880

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=7500

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@vencendoconcursos.com.br"
MAIL_FROM_NAME="${APP_NAME}"

TUTORY_WEBHOOK_SECRET=secret-local
TUTORY_WEBHOOK_URL="${APP_URL}/webhooks/tutory"

PANDA_AUTH_HEADER=Authorization
PANDA_AUTH_SCHEME=
PANDA_FOLDERS_PATH=/folders
PANDA_FOLDER_NAME_FIELD=name
PANDA_FOLDER_PARENT_PAYLOAD_KEY=
PANDA_FOLDER_PARENT_QUERY_PARAM=
PANDA_VIDEO_CREATE_PATH=/videos
PANDA_VIDEO_UPLOAD_PATH=/videos
PANDA_VIDEO_BINARY_UPLOAD_PATH=/videos/{id}
PANDA_VIDEO_UPLOAD_MODE=tus
PANDA_VIDEO_FILE_FIELD=file
PANDA_VIDEO_TITLE_FIELD=title
PANDA_VIDEO_FOLDER_FIELD=folder_id
PANDA_VIDEO_UPLOAD_TIMEOUT=600
PANDA_VIDEO_UPLOAD_DELAY_SECONDS=0
PANDA_VIDEO_UPLOAD_RETRY_ATTEMPTS=8
PANDA_VIDEO_UPLOAD_RETRY_DELAY_SECONDS=120
PANDA_UPLOADER_BASE_URL=https://uploader.pandavideo.com
PANDA_UPLOADER_PATH=/files/
PANDA_UPLOADER_AUTH_SCHEME=
PANDA_UPLOADER_USER_ID=
PANDA_UPLOADER_VIDEO_LOOKUP_ATTEMPTS=6
PANDA_UPLOADER_VIDEO_LOOKUP_DELAY_SECONDS=2

GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_CREDENTIALS_PATH=storage/app/private/google-drive/credentials.json
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
